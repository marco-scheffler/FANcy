<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>FANcy</string>
    <key>CFBundleIdentifier</key>
    <string>com.fancy.app</string>
    <key>CFBundleName</key>
    <string>FANcy</string>
    <key>CFBundleDisplayName</key>
    <string>FANcy</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>4</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSUIElement</key>
    <true/>
    <!-- Sparkle auto-update. The appcast is committed to the repo and served
         from main; Sparkle compares CFBundleVersion against it, so that number
         must go up with every release. -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/marco-scheffler/FANcy/main/appcast.xml</string>
    <!-- The public half of the EdDSA key every update is signed with. Public on
         purpose: each copy of the app uses it to check that a download really
         came from here. The private half lives only in the maintainer's
         Keychain (account "fancy") — whoever holds it can ship code to every
         FANcy user, past notarization. -->
    <key>SUPublicEDKey</key>
    <string>STuwdJP2TEGr6jrHbgRAox9dUSv//MFr6rLiX8mx2Mk=</string>
    <!-- Check daily without asking first; installing still always needs a click. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
